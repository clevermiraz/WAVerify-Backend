# --- Application -----------------------------------------------------------
# production also turns off /docs, /redoc and /openapi.json, and switches new
# API keys from wav_test_ to wav_live_.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32-byte-hex-string-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REQUIRE_EMAIL_VERIFICATION=false

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://waverify:waverify@localhost:5432/waverify
REDIS_URL=redis://localhost:6379/0

# --- CORS / links ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Verification provider -------------------------------------------------
VERIFICATION_CACHE_TTL_SECONDS=300

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- Email -----------------------------------------------------------------
# `console` prints verification and reset links to the logs.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@waverify.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=



# Google OAuth client ID for "Continue with Google".
# Public by design — it identifies the app to Google and is visible in the
# browser either way. The client *secret* is never needed here; the backend
# verifies the ID token. Leave empty to hide the Google buttons.
GOOGLE_CLIENT_ID=772319780628-cnpqc11gu7m9d5gn8hps9ugacugej0d0.apps.googleusercontent.com