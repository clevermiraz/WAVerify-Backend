# --- Application -----------------------------------------------------------
# production also turns off /docs, /redoc and /openapi.json, and switches new
# API keys from wav_test_ to wav_live_.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32-byte-hex-string-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REQUIRE_EMAIL_VERIFICATION=false

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://waverify:waverify@localhost:5432/waverify
REDIS_URL=redis://localhost:6379/0

# --- CORS / links ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Verification provider -------------------------------------------------
VERIFICATION_CACHE_TTL_SECONDS=300

# --- Provider pacing (anti-ban jitter) -------------------------------------
# Delays before each WhatsApp call, in seconds. Lower = faster but riskier.
# Set a *_MAX to 0 to disable that delay; set PROVIDER_ENRICH_PROFILE=false to
# skip about/photo/device lookups for the fastest possible response.
PROVIDER_LOOKUP_DELAY_MIN=0.2
PROVIDER_LOOKUP_DELAY_MAX=0.7
PROVIDER_ENRICH_DELAY_MIN=0.05
PROVIDER_ENRICH_DELAY_MAX=0.25
PROVIDER_ENRICH_PROFILE=true

# --- Gravatar enrichment ---------------------------------------------------
# Optional email->profile enrichment. Works without a key; a key from
# https://gravatar.com/developers/ only raises the hourly rate limit.
GRAVATAR_ENABLED=true
GRAVATAR_API_KEY=
GRAVATAR_TIMEOUT_SECONDS=4.0
GRAVATAR_CACHE_TTL_SECONDS=3600

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=no-reply@waverify.app

# --- Billing (Polar) -------------------------------------------------------
# Organization Access Token: Settings -> Developers -> New Token. Scopes:
# checkouts:read, checkouts:write, customer_sessions:write, customers:read, orders:read, products:read
# Sandbox and production tokens are separate; POLAR_SERVER must match the one
# you paste here, or every call 401s.
POLAR_ACCESS_TOKEN=
# Signing secret of the webhook endpoint (Settings -> Webhooks). A different
# value from the token above, and also per-environment. Without it the webhook
# refuses every delivery and no credits are ever granted.
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# Polar substitutes {CHECKOUT_ID} itself — leave the placeholder literal.
POLAR_SUCCESS_URL=http://localhost:3000/dashboard/billing?checkout_id={CHECKOUT_ID}

GOOGLE_CLIENT_ID=772319780628-cnpqc11gu7m9d5gn8hps9ugacugej0d0.apps.googleusercontent.com